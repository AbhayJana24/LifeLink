# 1. Supabase PostgreSQL + PostGIS (aws-1-ap-southeast-1)
# Transaction pooler (port 6543)
DATABASE_URL="postgresql://postgres.eomryyfzrbnfxdoudqjd:[YOUR-DATABASE-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler (port 5432) for migrations & seeding
